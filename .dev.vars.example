# bun run dev:setup creates .dev.vars.development from this template, filling
# the local Supabase key and a stable random recording capability secret.
# Runtime configuration comes from Wrangler, not .env.local.
NEXTJS_ENV=production

# Local workerd preview. APP_URL must match the browser origin.
APP_URL=http://localhost:8787
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PUBLISHABLE_KEY=

# Optional paid transcription. Configure the HTTPS tunnel first; importing or
# stopping a recording automatically requests processing when this key is set.
PYANNOTE_API_KEY=
RECORDING_CAPABILITY_SECRET=

# Optional paid inference; initialize an authorized durable allowance first.
SUMMARY_ENABLED=false
SUMMARY_AUTO_ENABLED=false
SUMMARY_REASONING_EFFORT=none
SUMMARY_MODEL=
SUMMARY_BUDGET_ID=

# Assistant turns use a separate approved allowance and immutable database rate.
# Never point these at an exhausted historical Summary budget.
ASSISTANT_ENABLED=false
ASSISTANT_MODEL=
ASSISTANT_BUDGET_ID=
ASSISTANT_RATE_VERSION_ID=

RESEARCH_ENABLED=false
RESEARCH_MODEL=
RESEARCH_BUDGET_ID=
RESEARCH_RATE_VERSION_ID=
RESEARCH_DISCOVERY_ENABLED=false
FIRECRAWL_API_KEY=
RESEARCH_SERVICE_BUDGET_ID=
RESEARCH_SEARCH_UNIT_BOUND=

# Connected-app tools require a pinned tool version and a separate service allowance.
COMPOSIO_ENABLED=false
COMPOSIO_API_KEY=
COMPOSIO_SLACK_AUTH_CONFIG_ID=
COMPOSIO_SLACK_TOOL_VERSION=
COMPOSIO_SERVICE_BUDGET_ID=
COMPOSIO_OPERATION_UNIT_BOUND=

CONVERSATION_SUMMARY_ENABLED=false
CONVERSATION_SUMMARY_MODEL=
CONVERSATION_SUMMARY_BUDGET_ID=
CONVERSATION_SUMMARY_RATE_VERSION_ID=

# Optional tracing: use a project write token and its region-specific base URL.
LOGFIRE_TOKEN=
LOGFIRE_BASE_URL=
LOGFIRE_ENVIRONMENT=development
