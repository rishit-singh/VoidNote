# Finalized processing runs in the Worker; browser live text needs no API key.
PYANNOTE_API_KEY=
RECORDING_CAPABILITY_SECRET=
# Reserved for future Summary/Ask.
OPENAI_API_KEY=
AI_CHAT_MODEL=gpt-4.1-mini
NEXT_PUBLIC_TRANSCRIPT_MARKDOWN_EXPORT=false
DATABASE_URL=

# Supabase Auth uses server-side cookies. APP_URL is the exact browser origin.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
APP_URL=http://localhost:3000

# Only isolated database tests use this URL; never point it at application data.
TEST_DATABASE_URL=postgresql://voidnote_test:voidnote_test@127.0.0.1:55432/voidnote_test

# Optional Workers tracing. The local Next server does not initialize a second SDK.
# Set the base URL for the Logfire project's region, for example:
# LOGFIRE_BASE_URL=https://logfire-us.pydantic.dev
LOGFIRE_TOKEN=
LOGFIRE_BASE_URL=
LOGFIRE_ENVIRONMENT=development
