{
  "name": "voidnote",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "bun@1.4.0",
  "engines": {
    "node": ">=24 <25",
    "bun": ">=1.4.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:worker": "opennextjs-cloudflare build --env production && bun scripts/prepare-worker-env.ts",
    "preview:worker": "opennextjs-cloudflare preview",
    "deploy:check": "wrangler deploy --env production --dry-run",
    "cf:typegen": "wrangler types --env production --strict-vars false --env-interface CloudflareEnv cloudflare-env.d.ts",
    "types:generate": "bun run cf:typegen && next typegen",
    "test:e2e": "playwright test",
    "test:worker": "node --test tests/worker/*.test.ts",
    "test:auth": "node --test tests/auth/*.test.ts",
    "start": "next start",
    "lint": "bun run types:generate && eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "bun run types:generate && tsc --noEmit && tsc --project tsconfig.tools.json --noEmit && tsc --project tsconfig.worker.json --noEmit && tsc --project tsconfig.worker-tests.json --noEmit && tsc --project tsconfig.auth-tests.json --noEmit && tsc --project tsconfig.db-tests.json --noEmit && tsc --project tests/e2e/tsconfig.json --noEmit",
    "db:generate": "bunx drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "test:db": "bun test tests/db",
    "db:studio": "bunx drizzle-kit studio"
  },
  "dependencies": {
    "@ai-sdk/react": "4.0.177",
    "@noble/hashes": "2.4.0",
    "@opentelemetry/api": "1.9.1",
    "@pydantic/otel-cf-workers": "2.1.7",
    "@radix-ui/react-alert-dialog": "^1.1.2",
    "@radix-ui/react-checkbox": "^1.4.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-icons": "^1.3.0",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-scroll-area": "^1.2.0",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-separator": "^1.2.0",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-switch": "^1.4.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-toggle": "^1.2.1",
    "@radix-ui/react-toggle-group": "^1.2.1",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.119.0",
    "@tanstack/react-query": "^5.107.1",
    "@trpc/client": "^11.28.2",
    "@trpc/server": "^11.28.2",
    "@trpc/tanstack-react-query": "^11.28.2",
    "@xenova/transformers": "^2.17.2",
    "ai": "7.0.173",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "drizzle-orm": "0.45.4",
    "embla-carousel-react": "^8.5.1",
    "idb": "^8.0.4",
    "lucide-react": "^0.452.0",
    "motion": "^14.14.0",
    "next": "16.4.6",
    "onnxruntime-web": "^1.19.2",
    "postgres": "^3.4.7",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "^9.0.1",
    "server-only": "0.0.1",
    "tailwind-merge": "^2.5.3",
    "tailwindcss-animate": "^1.0.7",
    "vite-plugin-copy": "^0.1.6",
    "zod": "4.6.7",
    "zustand": "5.1.0"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@opennextjs/cloudflare": "1.20.17",
    "@playwright/test": "1.65.1",
    "@stylistic/eslint-plugin": "^6.0.0",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/webspeechapi": "^0.0.29",
    "@vitejs/plugin-basic-ssl": "^1.1.0",
    "@vitejs/plugin-react": "^4.3.2",
    "autoprefixer": "^10.4.20",
    "drizzle-kit": "0.31.11",
    "esbuild": "0.25.12",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-refresh": "^0.4.12",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "globals": "17.14.0",
    "miniflare": "5.20261113.0-beta",
    "postcss": "^8.4.47",
    "prettier": "3.10.1",
    "tailwindcss": "^3.4.13",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vite": "^5.4.8",
    "wrangler": "4.162.0"
  }
}
