{
  "compilerOptions": {
    "target": "ES2024",
    "lib": ["ES2024"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["node", "./cloudflare-env.d.ts"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "erasableSyntaxOnly": true,
    "paths": { "@/*": ["./src/*"] }
  },
  "include": ["tests/worker/**/*.ts", "tests/proofs/**/*.ts", "types/open-next.d.ts"]
}
