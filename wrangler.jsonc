{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "voidnote-local",
  "main": "worker.ts",
  "compatibility_date": "2026-11-13",
  "compatibility_flags": ["nodejs_compat"],
  "upload_source_maps": true,
  "secrets": {
    "required": [],
  },
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
  },
  // Explicit opt-in until the migration and bounded provider proof are accepted.
  "vars": { "SUMMARY_ENABLED": "false", "SUMMARY_MODEL": "" },
  "ai": { "binding": "AI" },
  "durable_objects": {
    "bindings": [{ "name": "SUMMARY_AGENT", "class_name": "SummaryAgent" }],
  },
  "migrations": [{ "tag": "summary-agent-v1", "new_sqlite_classes": ["SummaryAgent"] }],
  "r2_buckets": [{ "binding": "RECORDING_ARTIFACTS", "bucket_name": "voidnote-recordings-local" }],
  "workflows": [
    {
      "binding": "SUMMARY_WORKFLOW",
      "name": "voidnote-summary-local",
      "class_name": "SummaryWorkflow",
    },
    {
      "binding": "PROCESS_RECORDING",
      "name": "voidnote-processing-local",
      "class_name": "RecordingProcessingWorkflow",
    },
  ],
  "env": {
    // Keep assets explicit so environment-specific type generation includes ASSETS.
    "staging": {
      "name": "voidnote-staging",
      "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
      "secrets": { "required": [] },
      "vars": { "SUMMARY_ENABLED": "false", "SUMMARY_MODEL": "" },
      "ai": { "binding": "AI" },
      "durable_objects": {
        "bindings": [{ "name": "SUMMARY_AGENT", "class_name": "SummaryAgent" }],
      },
      "r2_buckets": [
        { "binding": "RECORDING_ARTIFACTS", "bucket_name": "voidnote-recordings-staging" },
      ],
      "workflows": [
        {
          "binding": "SUMMARY_WORKFLOW",
          "name": "voidnote-summary-staging",
          "class_name": "SummaryWorkflow",
        },
        {
          "binding": "PROCESS_RECORDING",
          "name": "voidnote-processing-staging",
          "class_name": "RecordingProcessingWorkflow",
        },
      ],
    },
    "production": {
      "name": "voidnote-production",
      "workers_dev": true,
      "ai": { "binding": "AI" },
      "durable_objects": {
        "bindings": [{ "name": "SUMMARY_AGENT", "class_name": "SummaryAgent" }],
      },
      "r2_buckets": [
        { "binding": "RECORDING_ARTIFACTS", "bucket_name": "voidnote-recordings-production" },
      ],
      "workflows": [
        {
          "binding": "SUMMARY_WORKFLOW",
          "name": "voidnote-summary-production",
          "class_name": "SummaryWorkflow",
        },
        {
          "binding": "PROCESS_RECORDING",
          "name": "voidnote-processing-production",
          "class_name": "RecordingProcessingWorkflow",
        },
      ],
      "triggers": { "crons": ["* * * * *"] },
      "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
      "hyperdrive": [
        {
          "binding": "HYPERDRIVE",
          "id": "77f615af9cf34b0e843af2368e133933",
          // Local preview only; override through CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE.
          "localConnectionString": "postgresql://voidnote_test:voidnote_test@127.0.0.1:55432/voidnote_test",
        },
      ],
      "vars": {
        "SUMMARY_ENABLED": "false",
        "SUMMARY_MODEL": "",
        "APP_URL": "https://voidnote.app",
        "SUPABASE_URL": "https://rbacdtsvrogopijybsep.supabase.co",
      },
      "secrets": {
        "required": ["SUPABASE_PUBLISHABLE_KEY", "PYANNOTE_API_KEY", "RECORDING_CAPABILITY_SECRET"],
      },
    },
  },
}
